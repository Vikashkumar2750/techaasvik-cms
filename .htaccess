# ============================================================
# TECHAASVIK.COM — MASTER .HTACCESS
# ============================================================

Options -Indexes

# ============================================================
# 1. HTTPS ENFORCEMENT
# ============================================================
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# ============================================================
# 2. WWW → NON-WWW REDIRECT
# ============================================================
RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

# ============================================================
# 3. REMOVE TRAILING SLASH (except root)
# ============================================================
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)/$ /$1 [R=301,L]

# ============================================================
# 4. BLOCK ACCESS TO SENSITIVE DIRECTORIES & FILES
# ============================================================
RewriteRule ^app/ - [F,L]
# Allow image files from storage/uploads, block everything else in storage
RewriteRule ^storage/uploads/.*\.(jpe?g|png|gif|webp|svg|pdf)$ - [L]
RewriteRule ^storage/ - [F,L]
RewriteRule ^database/ - [F,L]
RewriteRule ^vendor/ - [F,L]
RewriteRule ^\.git/ - [F,L]

# Block sensitive files
<FilesMatch "(^\.env|^composer\.(json|lock)|^package\.json|^\.gitignore)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Block PHP execution in upload directory (using Rewrite instead of Directory)
RewriteRule ^assets/images/uploads/.*\.php$ - [F,L]

# ============================================================
# 5. FRONT CONTROLLER — ROUTE ALL REQUESTS TO index.php
# ============================================================
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php?url=$1 [QSA,L]

# ============================================================
# 6. SECURITY HEADERS
# ============================================================
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://www.google-analytics.com https://www.gstatic.com https://www.recaptcha.net https://checkout.razorpay.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://www.google-analytics.com https://api.razorpay.com; frame-src https://www.recaptcha.net https://www.youtube.com https://api.razorpay.com;"
</IfModule>

# ============================================================
# 7. GZIP COMPRESSION
# ============================================================
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE text/javascript application/javascript application/x-javascript
    AddOutputFilterByType DEFLATE application/json application/xml application/xhtml+xml
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ============================================================
# 8. BROWSER CACHING
# ============================================================
<IfModule mod_expires.c>
    ExpiresActive On

    # HTML — no cache (PHP pages must reflect immediately after deploy)
    ExpiresByType text/html "access plus 0 seconds"

    # CSS & JS — no aggressive caching; use Cache-Control revalidate instead
    # (filemtime()-based query strings bust cache on deploy)
    ExpiresByType text/css                    "access plus 0 seconds"
    ExpiresByType application/javascript      "access plus 0 seconds"
    ExpiresByType text/javascript             "access plus 0 seconds"

    # Images — long cache (rarely change)
    ExpiresByType image/jpeg    "access plus 1 year"
    ExpiresByType image/png     "access plus 1 year"
    ExpiresByType image/webp    "access plus 1 year"
    ExpiresByType image/gif     "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon  "access plus 1 year"

    # Fonts — long cache (never change)
    ExpiresByType font/woff2              "access plus 1 year"
    ExpiresByType font/woff               "access plus 1 year"
    ExpiresByType application/font-woff2  "access plus 1 year"
</IfModule>

# HTML — no-store so PHP changes reflect immediately
<IfModule mod_headers.c>
    <FilesMatch "\.php$">
        Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "Thu, 01 Jan 1970 00:00:00 GMT"
    </FilesMatch>
</IfModule>

# CSS & JS — must revalidate (no stale serving after deploy)
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "no-cache, must-revalidate"
        Header unset Pragma
    </FilesMatch>
</IfModule>


# ============================================================
# 9. HOTLINK PROTECTION FOR IMAGES
# ============================================================
RewriteCond %{HTTP_REFERER} !^$
RewriteCond %{HTTP_REFERER} !^https://(.*\.)?techaasvik\.com [NC]
RewriteRule \.(jpg|jpeg|png|gif|webp|svg)$ - [F,NC]

# ============================================================
# 10. CUSTOM ERROR PAGES
# ============================================================
ErrorDocument 400 /errors/400
ErrorDocument 403 /errors/403
ErrorDocument 404 /errors/404
ErrorDocument 500 /errors/500
